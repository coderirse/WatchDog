<?xml version="1.0" encoding="utf-8"?>
<!--
   API Key 与额度缓存均排除出云备份和换机迁移，避免敏感数据离开设备。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="watchdog_settings.xml"/>
        <exclude domain="sharedpref" path="watchdog_cache.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="watchdog_settings.xml"/>
        <exclude domain="sharedpref" path="watchdog_cache.xml"/>
    </device-transfer>
</data-extraction-rules>
